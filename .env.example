# Server-only configuration. No Supabase Auth or frontend credentials.
# For local compose: postgresql://unloop:unloop_local_dev@127.0.0.1:15432/unloop
# Or use a non-production Supabase PostgreSQL connection with required TLS options.
DATABASE_URL=
APP_ORIGIN=http://127.0.0.1:5173
# Explicit HTTP localhost override. HTTPS deployments must set this to true (default).
SESSION_COOKIE_SECURE=false
SESSION_TTL_SECONDS=28800
# Optional dedicated PostgreSQL test DB. Tests create/drop their own random schemas.
TEST_DATABASE_URL=
# Live extraction + diagnostics: fixed GPT-6.1 Sol model; availability remains unverified.
OPENAI_API_KEY=
# Content-free Arize AX tracing; separate from paid model activation.
ARIZE_ENABLED=false
ARIZE_API_KEY=
ARIZE_SPACE_ID=
ARIZE_PROJECT_NAME=unloop
# Match the region of the selected Arize space.
ARIZE_REGION=us
OPEN_EXCHANGE_RATES_APP_ID=

# All activation decisions remain explicit. Examples below keep paid calls/policy disabled.
A1_ENABLED=false
A1_MAX_CALLS=100
A1_MAX_SESSION_CALLS=50
A1_BUDGET_USD=5.00
# Standard GPT-6.1 Sol floors. Reservations use the entire configured envelope.
A1_INPUT_USD_PER_MILLION=2.00
A1_OUTPUT_USD_PER_MILLION=10.00
A1_MAX_INPUT_TOKENS=24000
A1_MAX_OUTPUT_TOKENS=4000
A1_TIMEOUT_SECONDS=25
MEAL_POLICY_APPROVED=false
MEAL_POLICY_EFFECTIVE_DATE=2026-10-01
MEAL_POLICY_ROUNDING=ROUND_HALF_UP_LINE
GROUND_POLICY_APPROVED=false
POLICY_QA_ENABLED=false
# Independent downstream credential, at least 32 random characters; server only.
APPROVED_API_TOKEN=
# Optional Gmail; exact APP_ORIGIN + /auth/google/callback must be registered.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GMAIL_TOKEN_KEY_VERSION=
GMAIL_TOKEN_KEYS=
